# WORKOUT//INDEX — ingress fragment for the shared Caddy edge.
#
# Version-controlled copy of the live file at
#   /opt/obsidian-livesync/caddy/workout.caddy
# on the edge host. The shared Caddyfile imports that directory with
#   import /etc/caddy/sites/*.caddy
# and Caddy reads it only at startup, so this file takes effect only after the shared proxy
# is restarted by its owner.
#
# The Cloudflare allowlist below is copied verbatim from the sibling girl-xtr blocks; it must
# stay identical or the origin would accept traffic that never passed through Cloudflare.
# Sync it programmatically from a live sibling rather than by hand:
#   grab 'not remote_ip ...' from a sibling fragment

workout.xtr.sh {
	encode zstd gzip

	# Only Cloudflare may reach the public origin.
	@notCloudflare not remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	respond @notCloudflare "Forbidden" 403

	# Public static app: no authentication gate, no API to exempt from caching.
	reverse_proxy workout-app:8080 {
		header_up X-Forwarded-Proto https
		header_up X-Real-IP {http.request.header.CF-Connecting-IP}
	}
}
